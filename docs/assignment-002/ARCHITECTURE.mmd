flowchart TD
    Main["main.ts — запуск"] --> Game["Game — управление приложением"]
    Main --> Assets["AssetManager — загрузка моделей"]

    Game --> Input["InputManager — клавиатура и touch"]
    Game --> Loop["GameLoop — фиксированный шаг 120 Гц"]
    Input -->|ось X/Y| Loop
    Loop -->|step| Model["ReleaseModel / GameModel — состояние забега"]

    Settings["release/settings.ts — правила фаз"] --> Model
    Model --> Ship["Ship — движение корабля"]
    Model --> Field["RuntimeObstacleField — препятствия"]
    Model --> Collision["WreckCollision — проверка столкновений"]
    Field -->|запрашивает секцию| Source["Mixed Flow / DifficultyDirector — выбор встреч"]
    Settings -->|интервалы встреч| Source
    Field -->|проверяет кандидата| Planner["RuntimePlanningSession / Validator — поиск и replay"]
    Planner -->|разрешает публикацию| Field

    Game --> World["World — сцена Three.js"]
    Assets -->|3D-ресурсы| World
    Game --> HUD["HUD — экран и показатели"]
    Game --> Audio["AudioManager / SoundPanel — звук и настройки"]
    Game --> Storage["StandalonePlatform / ScoreStorage — рекорд"]
    Model -.->|игровые данные через Game| World
    Model -.->|игровые данные через Game| HUD

    classDef core fill:#e5f3f7,stroke:#2d8298,color:#18313a;
    classDef orchestration fill:#263849,stroke:#263849,color:#ffffff;
    classDef generation fill:#fff2dc,stroke:#b87922,color:#503914;
    classDef presentation fill:#f0f2f5,stroke:#8f9ba8,color:#202b36;
    class Main,Game,Loop orchestration;
    class Model,Ship,Field,Collision core;
    class Source,Planner,Settings generation;
    class Input,Assets,World,HUD,Audio,Storage presentation;
